{
    "name": "mohammad-wq/api-version-platform",
    "description": "Local README-to-OpenAPI versioning for PHP projects.",
    "type": "library",
    "license": "MIT",
    "keywords": ["openapi", "api", "versioning", "swagger", "ui"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Mohammad\\ApiVersionPlatform\\": "src/"
        }
    },
    "bin": [
        "bin/avp",
        "bin/avp-serve"
    ],
    "scripts": {
        "sync": "@php scripts/sync.php",
        "lint": "@php scripts/lint.php",
        "test": [
            "@php tests/parser_test.php",
            "@php tests/storage_test.php",
            "@php tests/publish_test.php",
            "@php tests/hosted_smoke_test.php",
            "@php tests/tester_test.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
